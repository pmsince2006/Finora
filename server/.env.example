# Finora Server Configuration (Local Development)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/finora

# JWT Secret Key (Use a strong, random 32+ character string in production)
JWT_SECRET=finora_local_development_secret_key_change_me_32chars

# Allowed Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
